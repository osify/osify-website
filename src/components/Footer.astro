---
import { SITE, supportEnabled } from '../lib/site';
import { allPosts } from '../lib/posts';
import SupportCoffee from './SupportCoffee.astro';

const posts = await allPosts();
const years = posts.length
  ? `${posts[posts.length - 1].data.date.getUTCFullYear()}–${posts[0].data.date.getUTCFullYear()}`
  : '';
---

<footer class="mt-24 border-t border-rule">
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8">
    <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
      <div class="lg:col-span-2">
        <p class="text-lg font-bold tracking-[-0.04em] text-ink">OSIFY</p>
        <p class="mt-2 max-w-sm text-sm leading-relaxed text-muted">
          {SITE.description}
        </p>
        <p class="meta mt-4">
          {posts.length} articles · {years}
        </p>
      </div>

      <div>
        <p class="meta">Browse</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/archive/" class="link-draw text-muted hover:text-ink">Full archive</a></li>
          <li><a href="/topics/" class="link-draw text-muted hover:text-ink">Topics</a></li>
          <li><a href="/work/" class="link-draw text-muted hover:text-ink">Work</a></li>
          <li><a href="/about/" class="link-draw text-muted hover:text-ink">About</a></li>
        </ul>
      </div>

      <div>
        <p class="meta">Follow</p>
        <ul class="mt-3 space-y-2 text-sm">
          <li><a href="/rss.xml" class="link-draw text-muted hover:text-ink">RSS feed</a></li>
          <li><a href="/sitemap-index.xml" class="link-draw text-muted hover:text-ink">Sitemap</a></li>
          <li>
            <a href="https://github.com/osify" rel="me noopener" class="link-draw text-muted hover:text-ink">
              GitHub
            </a>
          </li>
          {
            supportEnabled && (
              <li>
                <SupportCoffee variant="inline" />
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-rule pt-6 sm:flex-row sm:items-start sm:justify-between">
      <p class="meta max-w-md leading-relaxed">
        © 2008–{new Date().getFullYear()} OSIFY · Articles remain the work of their original authors
        <br />
        Text and images licensed
        <a
          href="/license/"
          rel="license"
          class="underline decoration-rule underline-offset-2 hover:text-stamp hover:decoration-stamp"
        >
          CC BY-NC-ND 4.0
        </a>
        · code
        <a
          href="https://github.com/osify/osify-website/blob/main/LICENSE"
          rel="noopener"
          class="underline decoration-rule underline-offset-2 hover:text-stamp hover:decoration-stamp"
        >
          MIT
        </a>
      </p>
      <p class="meta">
        Previously published at osify.com and ask.osify.com
      </p>
    </div>
  </div>
</footer>
