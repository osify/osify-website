---
import type { Post } from '../lib/posts';
import { formatShort, slugifyTerm, ORIGIN_LABELS } from '../lib/site';

interface Props {
  post: Post;
  /** Show the full date rather than day+month (used outside year groupings). */
  fullDate?: boolean;
}

const { post, fullDate = false } = Astro.props;
const { title, date, author, categories, lang, origin, excerpt } = post.data;
const category = categories[0];
---

<article class="group border-b border-rule last:border-b-0">
  <a href={`/posts/${post.id}/`} class="grid gap-1 py-5 sm:grid-cols-[6.5rem_1fr] sm:gap-6">
    <time
      datetime={date.toISOString()}
      class="meta pt-1 tabular-nums transition-colors group-hover:text-stamp"
    >
      {fullDate ? date.toISOString().slice(0, 10) : formatShort(date)}
    </time>

    <div class="min-w-0">
      <h3
        lang={lang}
        class="text-balance text-lg font-semibold leading-snug tracking-[-0.02em] text-ink transition-colors group-hover:text-stamp"
      >
        {title}
      </h3>

      {
        excerpt && (
          <p lang={lang} class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-muted">
            {excerpt}
          </p>
        )
      }

      <p class="meta mt-2 flex flex-wrap items-center gap-x-2 gap-y-1">
        <span>{author}</span>
        {category && <span aria-hidden="true">·</span>}
        {category && <span>{category}</span>}
        <span aria-hidden="true">·</span>
        <span class="text-faint">{ORIGIN_LABELS[origin.site]}</span>
      </p>
    </div>
  </a>
</article>
