---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import ArchiveFilter from '../../components/vue/ArchiveFilter.vue';
import { allPosts, groupByYear, categoryCounts } from '../../lib/posts';
import { slugifyTerm, ORIGIN_LABELS } from '../../lib/site';

const posts = await allPosts();
const groups = groupByYear(posts);
const peak = Math.max(...groups.map((group) => group.posts.length), 1);
const categories = categoryCounts(posts);

/** Flat, serialisable shape for the filtering island. */
const items = posts.map((post) => ({
  slug: post.id,
  title: post.data.title,
  excerpt: post.data.excerpt,
  date: post.data.date.toISOString().slice(0, 10),
  year: post.data.date.getUTCFullYear(),
  author: post.data.author,
  lang: post.data.lang,
  site: post.data.origin.site,
  siteLabel: ORIGIN_LABELS[post.data.origin.site],
  categories: post.data.categories.map((name) => ({ name, slug: slugifyTerm(name) })),
}));
---

<BaseLayout
  title="Archive"
  description={`Every one of the ${posts.length} articles in the OSIFY archive, ${groups[groups.length - 1]?.year} to ${groups[0]?.year}, filterable by year, topic and source.`}
>
  <div class="mx-auto max-w-6xl px-5 py-12 sm:px-8 sm:py-16">
    <header class="max-w-2xl">
      <p class="meta">Complete index</p>
      <h1 class="mt-3 text-balance font-bold tracking-[-0.04em] text-ink" style="font-size: var(--text-title)">
        The archive
      </h1>
      <p class="mt-4 text-base leading-relaxed text-muted">
        Everything published across osify.com and ask.osify.com, in one chronological run. Filter by
        year, topic or original source — or press <kbd class="font-mono text-xs">/</kbd> to search.
      </p>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-[9.5rem_1fr] lg:gap-12">
      {/*
        The spine: one tick per year, its length proportional to how much was
        published that year. It is the table of contents and the shape of the
        archive at the same time.
      */}
      <nav class="hidden lg:block" aria-label="Jump to year">
        <ol class="sticky top-28 space-y-1.5">
          {
            groups.map((group) => (
              <li>
                <a
                  href={`#y${group.year}`}
                  class="group flex items-center gap-2 py-0.5"
                  aria-label={`${group.posts.length} articles in ${group.year}`}
                >
                  <span class="w-8 shrink-0 font-mono text-[0.7rem] tabular-nums text-faint transition-colors group-hover:text-stamp">
                    {group.year}
                  </span>
                  <span
                    class="h-[3px] rounded-full bg-rule transition-colors group-hover:bg-stamp"
                    style={`width: ${Math.max(8, (group.posts.length / peak) * 100)}%`}
                  />
                  <span class="font-mono text-[0.65rem] tabular-nums text-faint opacity-0 transition-opacity group-hover:opacity-100">
                    {group.posts.length}
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="min-w-0">
        <ArchiveFilter client:load items={items} categories={categories} />
      </div>
    </div>
  </div>
</BaseLayout>
