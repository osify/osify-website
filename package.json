{
  "name": "osify-website",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "osify.com — the merged archive of osify.com and ask.osify.com, rebuilt as a static Astro site.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "migrate": "node scripts/migrate.mjs",
    "migrate:media": "node scripts/migrate-media.mjs",
    "migrate:external": "node scripts/fetch-external.mjs",
    "migrate:blogspot": "node scripts/migrate-blogspot.mjs",
    "migrate:redirects": "node scripts/build-legacy-redirects.mjs",
    "migrate:fonts": "node scripts/fetch-fonts.mjs",
    "migrate:all": "npm run migrate:media && npm run migrate:external && npm run migrate && npm run migrate:blogspot && npm run migrate:redirects"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.12",
    "@astrojs/sitemap": "^3.5.1",
    "@astrojs/vue": "^5.1.1",
    "astro": "^5.14.1",
    "vue": "^3.5.22"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "sharp": "^0.34.4",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4"
  }
}
